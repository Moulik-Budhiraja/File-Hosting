{
  "name": "@moulikbudhiraja/fs-cli",
  "version": "0.2.0",
  "description": "CLI for files.moulik.dev",
  "author": "Moulik Budhiraja",
  "keywords": [
    "file-hosting",
    "cli",
    "upload",
    "agents"
  ],
  "homepage": "https://github.com/Moulik-Budhiraja/File-Hosting#readme",
  "bugs": {
    "url": "https://github.com/Moulik-Budhiraja/File-Hosting/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moulik-Budhiraja/File-Hosting.git",
    "directory": "cli"
  },
  "type": "module",
  "bin": {
    "fs": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "glob": "^13.0.6",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
