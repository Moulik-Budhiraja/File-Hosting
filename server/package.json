{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "node .next/standalone/server.js",
    "test": "tsx --tsconfig tsconfig.test.json --test src/server/files/*.test.ts src/admin/*.test.ts src/admin/*.test.tsx",
    "test:watch": "tsx --tsconfig tsconfig.test.json --test --watch src/server/files/*.test.ts src/admin/*.test.ts src/admin/*.test.tsx",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test e2e/admin.spec.ts e2e/edge.spec.ts",
    "test:ci": "npm run check && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "mime-types": "^3.0.1",
    "next": "^15.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.5.22",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
