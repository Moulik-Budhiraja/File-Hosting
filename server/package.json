{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assert:runtime": "node runtime/assert-runtime-assets.mjs",
    "build": "npm run assert:runtime && next build && node scripts/prepare-standalone.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:ui",
    "design:audit": "node --expose-gc --import tsx scripts/design-audit.ts",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,md,json}\" \"../tests/**/*.{mjs,cjs}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,md,json}\" \"../tests/**/*.{mjs,cjs}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "node .next/standalone/start.js",
    "test": "tsx --test --test-concurrency=1 src/server/auth/*.test.ts src/server/files/*.test.ts",
    "test:compiled": "npm run build && OG_E2E_MODE=compiled node scripts/standalone-og-e2e.mjs",
    "test:standalone": "npm run build && node scripts/standalone-og-e2e.mjs",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "tsx --test --watch src/server/auth/*.test.ts src/server/files/*.test.ts",
    "package:check": "node scripts/package-assets-check.mjs",
    "probe:markdown": "node scripts/markdown-preview-probe.mjs",
    "probe:rich-link": "node scripts/rich-link-preview-probe.mjs",
    "release:check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run package:check && node --test ../tests/compose.test.mjs && npm run test:compiled && npm run test:standalone && npm run design:audit",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@napi-rs/canvas": "^0.1.80",
    "@twemoji/svg": "15.0.0",
    "bcrypt": "^6.0.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "markdown-it": "^15.0.0",
    "mime-types": "^3.0.1",
    "next": "^15.5.22",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.3",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.5.22",
    "jsdom": "^30.0.1",
    "pdf-lib": "^1.17.1",
    "playwright-core": "1.62.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^4.1.10",
    "yazl": "^3.3.1"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
