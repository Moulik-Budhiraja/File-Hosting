{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build && node scripts/prepare-standalone.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:ui",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "node .next/standalone/server.js",
    "test": "tsx --test src/server/auth/*.test.ts src/server/files/*.test.ts",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "tsx --test --watch src/server/auth/*.test.ts src/server/files/*.test.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "bcrypt": "^6.0.0",
    "mime-types": "^3.0.1",
    "next": "^15.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.5.22",
    "jsdom": "^30.0.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^4.1.10"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
