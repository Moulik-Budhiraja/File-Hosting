# Generate a long random value. Do not commit the populated .env file.
FS_TOKEN=replace-with-a-long-random-secret

# Public base URL used when the server returns preview and raw links.
FS_PUBLIC_URL=https://files.moulik.dev

# Defaults below match the bind mounts in compose.yaml.
DATABASE_URL=file:/data/sqlite/files.db
FS_STORAGE_DIR=/data/files
FS_MAX_UPLOAD_BYTES=10737418240
FS_MIN_FREE_BYTES=1073741824
FS_PORT=37641

# One-time first start only; remove both immediately after successful bootstrap.
# FS_BOOTSTRAP_USERNAME=admin
# FS_BOOTSTRAP_PASSWORD=set-a-unique-password-of-at-least-12-characters
